# Go build output
/bin/
*.exe
*.test
*.out

# Secrets (GROQ_API_KEY lives here, never commit it)
.env

.DS_Store

# Papers are fetched from arXiv by ingest, not committed
/data/papers/

# Model weights downloaded from Hugging Face by cmd/getmodel
/models/

